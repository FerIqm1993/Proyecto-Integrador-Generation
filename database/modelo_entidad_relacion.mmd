erDiagram
    %% Modelo de database/esquema.sql.
    %% Identificadores en minúsculas; las FK conservan el nombre de la PK referenciada.
    %% inventario_sucursal usa una PK compuesta; detalle_pedido tiene una PK propia.
    %% Los importes se almacenan y se validan mediante restricciones check.
    roles ||--o{ usuarios : asigna
    usuarios o|--o{ pedidos : realiza
    sucursales ||--o{ pedidos : recibe
    metodos_pago ||--o{ pedidos : utiliza
    cupones o|--o{ pedidos : aplica
    pedidos ||--o{ detalle_pedido : contiene
    productos o|--o{ detalle_pedido : aparece_en
    categorias ||--o{ productos : clasifica
    sucursales ||--o{ inventario_sucursal : almacena
    productos ||--o{ inventario_sucursal : tiene_existencias
    usuarios o|--o{ mensajes_contacto : envia

    roles {
        bigint id_rol PK
        varchar nombre UK
    }
    usuarios {
        bigint id_usuario PK
        bigint id_rol FK
        varchar nombre
        varchar apellido
        varchar correo UK
        varchar telefono
        varchar password_hash
        boolean acepta_terminos
        boolean activo
        timestamp creado_en
        timestamp actualizado_en
    }
    categorias {
        bigint id_categoria PK
        varchar nombre UK
        varchar slug UK
        boolean activa
    }
    productos {
        bigint id_producto PK
        bigint id_categoria FK
        varchar nombre
        text descripcion
        decimal precio
        decimal precio_anterior
        varchar imagen_url
        boolean activo
        timestamp creado_en
        timestamp actualizado_en
    }
    sucursales {
        bigint id_sucursal PK
        varchar nombre
        varchar direccion
        varchar ciudad
        varchar estado
        varchar codigo_postal
        varchar horario
        varchar mapa_url
        boolean activa
    }
    inventario_sucursal {
        bigint id_sucursal PK, FK
        bigint id_producto PK, FK
        int existencia
        timestamp actualizado_en
    }
    cupones {
        bigint id_cupon PK
        varchar codigo UK
        decimal descuento_porcentaje
        boolean activo
        datetime valido_desde
        datetime valido_hasta
        int maximo_usos
        int usos
        timestamp creado_en
    }
    metodos_pago {
        bigint id_metodo_pago PK
        varchar nombre UK
        boolean activo
    }
    pedidos {
        bigint id_pedido PK
        bigint id_usuario FK
        bigint id_sucursal FK
        bigint id_metodo_pago FK
        bigint id_cupon FK
        varchar estado
        varchar estado_pago
        varchar nombre_cliente
        varchar correo_cliente
        varchar telefono_cliente
        varchar codigo_cupon
        decimal subtotal
        decimal descuento
        decimal total
        timestamp creado_en
        timestamp actualizado_en
    }
    detalle_pedido {
        bigint id_detalle_pedido PK
        bigint id_pedido FK
        bigint id_producto FK
        varchar nombre_producto
        int cantidad
        decimal precio_unitario
        decimal subtotal
    }
    mensajes_contacto {
        bigint id_mensaje_contacto PK
        bigint id_usuario FK
        varchar nombre
        varchar correo
        varchar telefono
        varchar motivo
        text mensaje
        boolean acepta_aviso_privacidad
        varchar estado
        timestamp creado_en
    }
